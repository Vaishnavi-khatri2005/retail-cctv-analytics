# RetailVision AI - Environment Configuration Example
# Copy this file to .env and insert your genuine API key:
# copy .env.example .env

# Gemini API Key (Required for live Gemini LLM search & investigation summaries)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Next.js Frontend Configuration (optional, default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
